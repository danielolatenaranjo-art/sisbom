{
  "expo": {
    "name": "SENTINEL ONE",
    "slug": "sentinel-one",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#060911"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.misisbom.sisbom.NFR3L3CC3L",
      "buildNumber": "300",
      "infoPlist": {
        "CFBundleDisplayName": "SENTINEL ONE",
        "NSLocationWhenInUseUsageDescription": "SENTINEL ONE utiliza su ubicación para rutar la respuesta hacia la emergencia de bomberos y confirmar llegada al cuartel.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SENTINEL ONE recopila datos de ubicación durante un despacho activo para el cálculo de rutas tácticas y seguridad del bombero, incluso con la app cerrada.",
        "UIBackgroundModes": [
          "location",
          "audio",
          "remote-notification",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.sisbom.misisbom",
      "versionCode": 300,
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#060911"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/Logo.png"
    }
  }
}
