rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isDespachoFinalizado() {
      return resource != null && (
        (resource.data.keys().hasAny(['estado']) && (
          resource.data.estado == 'finalizada' || 
          resource.data.estado == 'FINALIZADA' || 
          resource.data.estado == 'cerrada' || 
          resource.data.estado == 'CERRADA' || 
          resource.data.estado == 'terminada' || 
          resource.data.estado == 'TERMINADA' || 
          resource.data.estado == 'cancelada' || 
          resource.data.estado == 'CANCELADA'
        )) ||
        (resource.data.keys().hasAny(['ESTADO']) && (
          resource.data.ESTADO == 'finalizada' || 
          resource.data.ESTADO == 'FINALIZADA' || 
          resource.data.ESTADO == 'cerrada' || 
          resource.data.ESTADO == 'CERRADA' || 
          resource.data.ESTADO == 'terminada' || 
          resource.data.ESTADO == 'TERMINADA' || 
          resource.data.ESTADO == 'cancelada' || 
          resource.data.ESTADO == 'CANCELADA'
        )) ||
        (resource.data.keys().hasAny(['operadorFinal']) && resource.data.operadorFinal != '')
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // personal collection - Bloquear escrituras de GPS residuales de versiones antiguas
    match /personal/{idRegistro} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated();
      allow update: if isAuthenticated() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lat', 'lng', 'heading', 'velocidad', 'gpsTimestamp', 'gpsHora', 'speedKmH', 'accuracy', 'gpsAccuracy']));

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // vehiculos collection - Bloquear escrituras de GPS residuales de tablets
    match /vehiculos/{id} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated();
      allow update: if isAuthenticated() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lat', 'lng', 'heading', 'velocidad', 'gpsTimestamp', 'gpsHora', 'speedKmH', 'accuracy', 'gpsAccuracy', 'posicionGps', 'ultimaActualizacionGps']));

      match /historial/{logId} {
        allow read, write: if isAuthenticated();
      }
    }

    // despachos collection - Bloquear sobreescrituras en despachos finalizados
    match /despachos/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && !isDespachoFinalizado();
      allow delete: if isAuthenticated() && !isDespachoFinalizado();

      // Tripulantes subcollection
      match /tripulantes/{docId} {
        allow read, write: if isAuthenticated();
      }

      // Explicitly block asistencias writes (GPS telemetry moved to RTDB)
      match /asistencias/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // geolocalizaciones_alertantes collection (SOS web alertants)
    match /geolocalizaciones_alertantes/{id} {
      allow read, write: if true;
    }

    // geolocalizaciones_bomberos collection (BLOCKED - now uses Realtime Database)
    match /geolocalizaciones_bomberos/{id} {
      allow read, write: if false;
    }

    // alertas collection
    match /alertas/{id} {
      allow read, write: if isAuthenticated();
    }

    // bitacora collection
    match /bitacora/{id} {
      allow read, write: if isAuthenticated();
    }

    // asistencia collection (Asistencia por cuartel)
    match /asistencia/{id} {
      allow read, write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // sirena collection
    match /sirena/{id} {
      allow read, write: if isAuthenticated();
    }

    // prueba_radial collection
    match /prueba_radial/{id} {
      allow read, write: if isAuthenticated();

      match /{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // accesos collection
    match /accesos/central {
      allow read, write: if true;
    }

    match /accesos/central/registros/{id} {
      allow read, write: if true;
    }

    match /accesos/comandancia/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // solicitudes_puerta collection (Timbre de acceso a la Central)
    match /solicitudes_puerta/{id} {
      allow read, write: if true;
    }

    // fcm_tokens collection
    match /fcm_tokens/{token} {
      allow read, write: if true;
    }

    // saas_clientes collection
    match /saas_clientes/{licenciaKey} {
      allow read, write: if true;
    }

    // llamadas collection (SisBomTel Caller ID en tiempo real)
    match /llamadas/{id} {
      allow read, write: if true;
    }

    // historial_llamadas collection (SisBomTel registro de llamadas)
    match /historial_llamadas/{id} {
      allow read, write: if true;
    }

    // sms_queue collection (SisBomTel pasarela SMS y cola de salida)
    match /sms_queue/{id} {
      allow read, write: if true;
    }

    // configuracion, unidades, cuarteles, usuarios general
    match /configuracion/{id} {
      allow read, write: if isAuthenticated();
    }
    match /unidades/{id} {
      allow read, write: if isAuthenticated();
    }
    match /cuarteles/{id} {
      allow read, write: if isAuthenticated();
    }
    match /usuarios/{id} {
      allow read, write: if isAuthenticated();
    }
  }
}
