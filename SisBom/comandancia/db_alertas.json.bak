[{"idAlerta":"1","conforme":"71,23,134,24,166,137,101,21,104,20,21B,8,9,156,102,136,145,103,161,32,159,164,124,165,1,121,7,29,41,154,167,107,6,18,11,C1","fijar":"","quienAlerta":"Comandante Cristian Lopez Mella","horaAlerta":"'15:59","mensajeAlerta":"TRAS LAS CONTINUAS MEJORAS EN EL SISTEMA DE TELECOMUNICACIONES Y INFORMÁTICA. Y SEGÚN ME CONFIERE EL REGLAMENTO. DICTO LA SIGUIENTE ORDEN: \n\nI.- NOMBRASE AYUDANTE DE COMANDANCIA A DON DANIEL OLATE NARANJO. EN EL GRADO DE INFORMÁTICA, TELECOMUNICACIONES, CÓDIGO RADIAL 23. ADEMÁS DE AYUDANTÍA ESPECIAL A DON JUAN MARTÍNEZ CORNEJO. MANTENIENDO CÓDIGO RADIAL. \n\nII.- SE INFORMA QUE A CONTAR DEL DÍA LUNES 22 SE PONDRÁ EN MARCHA UN NOVEDOSO SISTEMA EN LA CENTRAL DE ALARMAS EL CUAL SERA DE MARCHA BLANCA, HASTA QUE SE ESTIME NECESARIO EN EL TIEMPO Y SI ES EXITOSO SE PONDRÁ EN MARCHA. A TRAVÉS DE DISTINTAS PETICIONES DE INFORMACIÓN SE IRA IMPLEMENTANDO ESTE SISTEMA.  SE DISPONDRÁ DE DATOS QUE TENDRÁN QUE DAR DE SUS SISTEMAS TECNOLÓGICOS, LLÁMESE TELÉFONOS Y DISTINTOS COMPUTADORES, LOS CUALES TENDRÁ, UN USO DEL DATO DE IDENTIFICACIÓN DEL EQUIPO Y ESTO SERÁ INVIOLABLE PARA NUESTRO FUTURO SISTEMA DE DESPACHO.","firmaCargo":"COMANDANTE ","razonAlerta":"ORDEN DEL DIA 12/2026","tipo":"orden","numeroOrden":"12/2026","gradoAlerta":"1","fechaOrden":"'19-06-2026","aQuienAlerta":"TC","duracion":"i","fechaAlerta":"'24-06-2026","firmaNombre":"CRISTIAN LOPEZ MELLA","id":"1","ID":"1","idRegistro":"1"},{"quienAlerta":"Central de Alarmas operador BRIGIDA ADASME CABELLO","fechaAlerta":"'24-06-2026","duracion":"","mensajeAlerta":"24-06-2026/20:10/124: HOLA | 24-06-2026/20:11/137: .. ||24-06-2026/20:12/224: hola","razonAlerta":".,","ID":"2","conforme":"","gradoAlerta":"1","idAlerta":"2","aQuienAlerta":"216, 224","horaAlerta":"'20:10","fijar":"","id":"2","idRegistro":"2"},{"conforme":"1, 101, 29, 134, 120, 32, 161, 9, 18, 137, 147, C1, 8, 166, 121, 21B, 104, 164, 145, 21, 103, 136, 23, 156, 167, 24, 102","quienAlerta":"Inspector de ... - DANIEL OLATE NARANJO","fechaAlerta":"'26-06-2026","idAlerta":"3","razonAlerta":"PRUEBA   POSIBLE APOYO A VENEZUELA","fijar":"18, 134","mensajeAlerta":"POR ORDEN DE 1 ALERTAMIENTO ANTE POSIBLE DESPLIEGUE A VENEZUELA   PRUEBA DEL SISTEMA","duracion":"'26-06-2026 22:12","gradoAlerta":"3","horaAlerta":"'21:12","aQuienAlerta":"TC","id":"3","ID":"3","idRegistro":"3"},{"fijar":"","numeroOrden":"13/2026","mensajeAlerta":"DIA DEL BOMBERO. Y SEGÚN ME CONFIERE EL REGLAMENTO. DICTO LA SIGUIENTE \nORDEN: \nI.- CITASE AL PERSONAL DEL CUERPO DE BOMBEROS DE PLACILLA, A ROMERÍA PARA \nEL DÍA 30 DE JUNIO A LAS 19:20 HORAS EN CUARTEL GENERAL, EN TENIDA DE RESCATE \nEL PERSONAL ACTIVO, EN TENIDA DE PRESENTACIÓN EL PERSONAL HONORARIO Y EN \nTENIDA DE TRABAJO LA BRIGADA.   LAS EXCUSAS POR ESCRITO O WSP, JUSTIFICABLES. \nAL DÍA DOMINGO 28 HASTA LAS 22 HORAS.","gradoAlerta":"1","fechaAlerta":"'26-06-2026","aQuienAlerta":"TC","idAlerta":"4","firmaNombre":"CRISTIAN LOPEZ MELLA","fechaOrden":"'27-06-2026","conforme":"199,237,71,21B,164,23,136,145,32,21,9,103,166,104,137,124,165,1,121,7,29,156,154,101,41,159,161,24,8,167,102,107,6,134,18,20,11,C1","tipo":"orden","horaAlerta":"'22:02","duracion":"i","firmaCargo":"COMANDANTE ","quienAlerta":"COMANDANTE CRISTIAN LOPEZ ","razonAlerta":"ORDEN DEL DIA 13/2026","id":"4","ID":"4","idRegistro":"4"},{"conforme":"23, 32, 1, 101, 103, 124, 164, 121, 29, 165, 163, 137, 159, 21, 9, 154, 166, 136, 11, 156, 18, 21B, 71, 8, 145, 24, 102, 104, 167","idAlerta":"5","gradoAlerta":"1","fijar":"1","horaAlerta":"'09:54","razonAlerta":"SALUDO PROTOCOLAR","aQuienAlerta":"TC","mensajeAlerta":"BUENOS DIAS\nME ES MUY GRATO CELEBRAR EL DÍA NACIONAL DEL BOMBERO EN NUESTRO PAÍS, ME ES GRATO,  YA QUE CONOZCO COMO SE HAN DESARROLLADO USTEDES EN EL TRANSCURSO DEL TIEMPO. TIEMPO QUE NOS ENSEÑA A DEFINIR NUESTROS OBJETIVOS DE SUPERACIÓN DE NUESTRA UNIDAD, QUÉ GRACIAS A DIOS SON LA INMENSA MAYORÍA DE USTEDES.\nNO CAER QUERIDOS BOMBEROS EN PEQUEÑECES QUE SE PRESENTAN EN NUESTRA SOCIEDAD. RECORDAR QUE EL BOMBERISMO NACIÓ PARA RESOLVER LA TRAGEDIA DE NUESTROS SEMEJANTES POR MÁS DE 175 AÑOS DE TRAYECTORIA E HISTORIA.\nHOY REFLEJADO EN NUESTROS PARES PRESENTES EN VENEZUELA, Y NO OLVIDEN QUE CON  'ABNEGACION Y SACRIFIO', TODO SERÁ MEJOR.\n\nFELIZ DIA DEL BOMBERO.","duracion":"'30-06-2026 23:59","fechaAlerta":"'30-06-2026","quienAlerta":"COMANDANTE - CRISTIAN LOPEZ MELLA ","id":"5","ID":"5","idRegistro":"5"},{"aQuienAlerta":"176, 222, 220, 209, 241, 162, 194, 224, 114","gradoAlerta":"2","idAlerta":"6","conforme":"23,1","ID":"6","razonAlerta":"RECORDATORIO","fijar":"","duracion":"'23-07-2026 20:00","horaAlerta":"'19:51","fechaAlerta":"'23-07-2026","quienAlerta":"Central de Alarmas operador BRIGIDA ADASME CABELLO","mensajeAlerta":"REUNION DE OFICIALES A LA 20:00","id":"6","idRegistro":"6"},{"mensajeAlerta":"POR ORDEN DEL SR. COMANDANTE \n CAPITAN Y 20 MAYCOL POBLETE  SOLICITA REVISAR MOTOSIERRAS  Y DEJARLAS OPERATIVAS EL DIA DE HOY VIERNES 24 DE JULIO","gradoAlerta":"1","horaAlerta":"'13:07","duracion":"'24-07-2026 20:00","aQuienAlerta":"114, 176, 232","razonAlerta":"MOTOSIERRAS","fijar":"","idAlerta":"7","conforme":"41","ID":"7","fechaAlerta":"'24-07-2026","quienAlerta":"Central de Alarmas operador BRIGIDA ADASME CABELLO","id":"7","idRegistro":"7"},{"duracion":"","horaAlerta":"'20:07","gradoAlerta":"1","aQuienAlerta":"TC","mensajeAlerta":"POR ORDEN DEL SEÑOR COMANDANTE ORDENA TENER  TODOS , SUS EQUIPOS RADIALES OPERATIVO Y BATERIAS CARGADAS SIN ESCANEAR  DURANTE LA NOCHE.\n\nCUMPLASE  COMANDANTE","razonAlerta":"COMUNICADO","fijar":"","conforme":"18, 224, 154, 23, 165, 134, 101, 166, 9, 103, 29, 11, 145, 167, 121, 32, 24","ID":"8","fechaAlerta":"'05-08-2026","quienAlerta":"Central de Alarmas operador BRIGIDA ADASME CABELLO","idAlerta":"8","id":"8","idRegistro":"8"}]